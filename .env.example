# Gmail used by Email Finder sending and delivery checks.
SMTP_GMAIL_USER=your-email@gmail.com
SMTP_GMAIL_PASS=your-app-password

# Comma-separated Google Places API keys for Place Finder.
GOOGLE_PLACES_API_KEYS=

# Optional. 64 hex characters. Encrypts warmup mailbox passwords.
ENCRYPTION_KEY=

# Optional. Durable warmup storage. Without these, mailboxes live in data/hearth.json.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional. If set, /api/warmup/tick requires Authorization: Bearer <secret>.
CRON_SECRET=

# Optional. Labels inbox replies with a model. Without it, phrase rules are used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
